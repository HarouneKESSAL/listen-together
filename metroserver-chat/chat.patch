@@ -0,0 +1,88 @@
+package server
+
+import (
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"go.uber.org/zap"
+)
+
+// Room chat (listen-together addition). Only members of the room (not pending joiners) can send,
+// and only members that negotiated FeatureChat receive, so clients without chat support are unaffected.
+const (
+	MaxChatMessageRunes = 500
+	ChatRateWindow      = 10 * time.Second
+	ChatRateLimit       = 8 // messages per window per client
+)
+
+// cleanChatText trims the message and replaces control characters (including newlines) with spaces.
+func cleanChatText(text string) string {
+	text = strings.Map(func(r rune) rune {
+		if unicode.IsControl(r) {
+			return ' '
+		}
+		return r
+	}, text)
+	return strings.TrimSpace(text)
+}
+
+// allowChat applies the per-client chat rate limit.
+func (c *Client) allowChat(now time.Time) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if now.Sub(c.chatWindowStart) > ChatRateWindow {
+		c.chatWindowStart = now
+		c.chatCount = 0
+	}
+	if c.chatCount >= ChatRateLimit {
+		return false
+	}
+	c.chatCount++
+	return true
+}
+
+func (s *Server) handleChatMessage(c *Client, payload []byte) {
+	var p ChatMessagePayload
+	if err := decodePayload(payload, MsgTypeChatMessage, &p); err != nil {
+		c.sendError(s.logger, "invalid_payload", "Invalid chat message payload")
+		return
+	}
+	text := cleanChatText(p.Text)
+	if text == "" || !utf8.ValidString(text) {
+		c.sendError(s.logger, "invalid_chat_message", "Message is empty")
+		return
+	}
+	if utf8.RuneCountInString(text) > MaxChatMessageRunes {
+		c.sendError(s.logger, "chat_message_too_long", "Message is too long")
+		return
+	}
+
+	room := c.currentRoom()
+	if room == nil {
+		c.sendError(s.logger, "not_in_room", "You are not in a room")
+		return
+	}
+	now := time.Now()
+	if !c.allowChat(now) {
+		c.sendError(s.logger, "chat_rate_limited", "You're sending messages too fast")
+		return
+	}
+
+	clientID := c.clientID()
+	room.mu.Lock()
+	if room.Clients[clientID] != c {
+		room.mu.Unlock()
+		c.sendError(s.logger, "not_in_room", "You are not in a room")
+		return
+	}
+	msg := ChatReceivedPayload{UserID: clientID, Username: c.userName(), Text: text, ServerTime: now.UnixMilli()}
+	recipients := withFeature(roomClientsLocked(room), FeatureChat)
+	room.mu.Unlock()
+
+	for _, member := range recipients {
+		member.sendMessage(s.logger, MsgTypeChatReceived, msg)
+	}
+	s.logger.Debug("Chat message", zap.String("room_code", room.Code), zap.String("from_user", clientID))
+}
diff --git a/internal/server/chat_test.go b/internal/server/chat_test.go
new file mode 100644
index 0000000..6703d24
--- /dev/null
+++ b/internal/server/chat_test.go
@@ -0,0 +1,82 @@
+package server
+
+import (
+	"strings"
+	"testing"
+
+	pb "github.com/MetrolistGroup/metroserver/proto"
+)
+
+func sendChat(t *testing.T, server *Server, from *Client, text string) {
+	t.Helper()
+	server.handleChatMessage(from, encodeTestPayload(t, MsgTypeChatMessage, &ChatMessagePayload{Text: text}))
+}
+
+func TestChatDeliversCleanTextToChatMembers(t *testing.T) {
+	server, _, host, guest := roomTestFixture()
+	withFeatures(host, FeatureChat)
+	withFeatures(guest, FeatureChat)
+
+	sendChat(t, server, guest, "  hi\nthere\t ")
+
+	for _, member := range []*Client{host, guest} {
+		var got pb.ChatReceivedPayload
+		if typ := receiveTestMessage(t, member, &got); typ != MsgTypeChatReceived {
+			t.Fatalf("message type = %q, want %q", typ, MsgTypeChatReceived)
+		}
+		if got.Text != "hi there" || got.UserId != "guest" || got.Username != "Guest" || got.ServerTime == 0 {
+			t.Fatalf("unexpected chat payload: %#v", &got)
+		}
+	}
+}
+
+func TestChatSkipsClientsWithoutFeature(t *testing.T) {
+	server, _, host, guest := roomTestFixture()
+	withFeatures(host, FeatureChat) // guest is e.g. the Metrolist app: no chat feature
+
+	sendChat(t, server, host, "hello")
+
+	if typ := receiveTestMessage(t, host, nil); typ != MsgTypeChatReceived {
+		t.Fatalf("host got %q, want %q", typ, MsgTypeChatReceived)
+	}
+	if types := drainTypes(t, guest); len(types) != 0 {
+		t.Fatalf("guest without chat feature got %v", types)
+	}
+}
+
+func TestChatRejectsNonMembersAndBadMessages(t *testing.T) {
+	server, room, host, _ := roomTestFixture()
+	withFeatures(host, FeatureChat)
+
+	t.Run("pending joiner", func(t *testing.T) {
+		pending := newClient("pending", nil)
+		pending.setUsername("Pending")
+		room.PendingJoins["pending"] = pending
+		sendChat(t, server, pending, "let me in")
+		receiveRoomError(t, pending, "not_in_room")
+		if types := drainTypes(t, host); len(types) != 0 {
+			t.Fatalf("host got %v from a pending joiner", types)
+		}
+	})
+	t.Run("empty", func(t *testing.T) {
+		sendChat(t, server, host, " \n\t ")
+		receiveRoomError(t, host, "invalid_chat_message")
+	})
+	t.Run("too long", func(t *testing.T) {
+		sendChat(t, server, host, strings.Repeat("é", MaxChatMessageRunes+1))
+		receiveRoomError(t, host, "chat_message_too_long")
+	})
+}
+
+func TestChatRateLimit(t *testing.T) {
+	server, _, host, _ := roomTestFixture()
+	withFeatures(host, FeatureChat)
+	for i := 0; i < ChatRateLimit; i++ {
+		sendChat(t, server, host, "spam")
+		if typ := receiveTestMessage(t, host, nil); typ != MsgTypeChatReceived {
+			t.Fatalf("message %d: got %q, want %q", i+1, typ, MsgTypeChatReceived)
+		}
+	}
+	sendChat(t, server, host, "one too many")
+	receiveRoomError(t, host, "chat_rate_limited")
+}
